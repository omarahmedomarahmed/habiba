{
  "name": "24therapy",
  "version": "2.0.0",
  "private": true,
  "description": "24Therapy \u2014 AI clinical documentation for therapists. Single mobile-first Next.js app.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "tsx scripts/migrate.ts && tsx scripts/settings.ts seed && tsx scripts/seed.ts",
    "test": "node --import tsx --conditions=react-server --test tests/safety.test.ts",
    "test:db": "node --import tsx --conditions=react-server --test tests/radar.test.ts",
    "test:alarm": "node --import tsx --test tests/alarm.test.ts",
    "test:e2e": "bash tests/run-e2e.sh",
    "demo:seed": "tsx scripts/demo.ts seed",
    "demo:purge": "tsx scripts/demo.ts purge",
    "test:ledger": "node --import tsx --conditions=react-server --test tests/ledger.test.ts",
    "test:clock": "node --import tsx --test tests/clock.test.ts",
    "test:toasts": "node --import tsx --test tests/toasts.test.ts",
    "test:transcribe": "node --import tsx --conditions=react-server --test tests/transcribe.test.ts",
    "settings:seed": "tsx scripts/settings.ts seed",
    "settings:show": "tsx scripts/settings.ts show",
    "settings:reprice": "tsx scripts/settings.ts reprice",
    "verify:sprint1": "tsx scripts/verify-sprint1.ts",
    "test:attribution": "node --import tsx --conditions=react-server --test tests/attribution.test.ts",
    "test:people": "node --import tsx --conditions=react-server --test tests/people.test.ts",
    "test:routing": "node --import tsx --conditions=react-server --test tests/routing.test.ts",
    "verify:sprint6": "node --import tsx --conditions=react-server scripts/verify-sprint6.ts",
    "verify:sprint7": "node --import tsx --conditions=react-server scripts/verify-sprint7.ts",
    "test:consent": "node --import tsx --conditions=react-server --test tests/consent.test.ts",
    "verify:sprint8": "node --import tsx --conditions=react-server scripts/verify-sprint8.ts",
    "test:documents": "node --import tsx --conditions=react-server --test tests/documents.test.ts",
    "verify:sprint9": "node --import tsx --conditions=react-server scripts/verify-sprint9.ts",
    "test:memory": "node --import tsx --conditions=react-server --test tests/memory.test.ts"
  },
  "dependencies": {
    "@daily-co/daily-js": "^0.91.0",
    "@neondatabase/serverless": "^1.1.0",
    "@types/ws": "^8.18.1",
    "@vercel/blob": "^2.7.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.3",
    "lucide-react": "^0.469.0",
    "next": "^15.5.4",
    "openai": "^4.77.0",
    "playwright": "^1.62.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.0.1",
    "server-only": "^0.0.1",
    "stripe": "^17.5.0",
    "tailwind-merge": "^2.6.0",
    "ws": "^8.21.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.30.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
