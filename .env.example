# ---- Required in production (the app refuses to boot without these) --------
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
AUTH_SECRET=generate-with-openssl-rand-hex-32
OPENAI_API_KEY=sk-...
STRIPE_WEBHOOK_SECRET=whsec_...
APP_URL=http://localhost:3000

# ---- Strongly recommended (the feature degrades without them) --------------
DAILY_API_KEY=
STRIPE_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM=24Therapy <noreply@24therapy.ai>
CRON_SECRET=

# ---- One connection string per environment ---------------------------------
# 🔴 76.42. DATABASE_URL above is "the database THIS process talks to". These
# three are "the three databases this product has", and they exist so that a
# question about all of them can be asked at once:
#
#   npm run settings:compare
#
# reads all three and fails when any setting group or country row differs. It
# READS on every connection and writes nowhere, which is why it can be pointed
# at production, and why it must be: production is the database that most needs
# asking and the one a write guard has always refused to let anybody ask.
#
# Each variable is checked against the Neon endpoint it is supposed to reach
# (scripts/_environments.ts), because a variable called DATABASE_URL_PRODUCTION
# holding the dev branch would make every comparison downstream of it a
# comparison of dev with dev, reported as agreement.
#
# Set locally only. Never in Vercel: nothing the deployed product does needs to
# reach a database other than its own.
DATABASE_URL_PRODUCTION=
DATABASE_URL_DEV=
DATABASE_URL_SIMULATION=

# ---- Optional --------------------------------------------------------------
# Non-pooled connection, for maintenance PgBouncer cannot carry
DATABASE_URL_DIRECT=
# Tri-state: unset means "on in production, off locally". Leave unset unless
# you run local Postgres without TLS.
DATABASE_SSL=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---- Seed script only (never set these in Vercel) --------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_TEST_EMAIL=test@24therapy.ai
SEED_TEST_PASSWORD=TestTherapist2026!

# 🔴 Required in production. Without it every upload is refused, which blocks
# therapist verification entirely (no licence, no clearance, nobody on the
# radar) and blocks an Egyptian payer from attaching their transfer receipt.
# In development you may set ALLOW_LOCAL_UPLOADS=1 instead.
BLOB_READ_WRITE_TOKEN=
