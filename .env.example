# ---- Required in production (the app refuses to boot without these) --------
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
AUTH_SECRET=generate-with-openssl-rand-hex-32
OPENAI_API_KEY=sk-...
STRIPE_WEBHOOK_SECRET=whsec_...
APP_URL=http://localhost:3000

# ---- Strongly recommended (the feature degrades without them) --------------
DAILY_API_KEY=
STRIPE_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM=24Therapy <noreply@24therapy.ai>
CRON_SECRET=

# ---- Optional --------------------------------------------------------------
# Non-pooled connection, for maintenance PgBouncer cannot carry
DATABASE_URL_DIRECT=
# Tri-state: unset means "on in production, off locally". Leave unset unless
# you run local Postgres without TLS.
DATABASE_SSL=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---- Seed script only (never set these in Vercel) --------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_TEST_EMAIL=test@24therapy.ai
SEED_TEST_PASSWORD=TestTherapist2026!
